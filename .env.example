# ═══════════════════════════════════════════════════════════════════
# JobHunting 配置
# 复制为 .env 后填入内容:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── 通知渠道（至少配一个，都不配则不推送）──

# Feishu / Lark（国内）— https://open.feishu.cn/
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_CHAT_ID=oc_xxxxxxxxxxxx

# Telegram（全球）— https://core.telegram.org/bots
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LLM（可选，启用后解锁智能功能）──
# 配置后 main.py agent 进入对话模式，支持 /fit /draft 等
#
# MiniMax（推荐，无需翻墙）:
#   从 FI-Agent 的 .env 复制以下三行，或自行注册 https://www.minimaxi.com/
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/anthropic
LLM_MODEL=MiniMax-M2.7-highspeed
#
# DeepSeek（需翻墙或国内镜像）:
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# OpenAI:
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
