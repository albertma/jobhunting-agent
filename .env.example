# ── Notification channels (configure at least one, or leave empty to disable) ──

# Feishu / Lark (popular in China) — https://open.feishu.cn/
# 1. Create a custom app → get App ID / App Secret
# 2. Add "im:message" permission & authorize the bot into your group chat
# 3. Chat ID: see Feishu docs (or use the API to list chats)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# Telegram (works worldwide) — https://core.telegram.org/bots
# 1. Talk to @BotFather → /newbot → get the token
# 2. Add the bot to your chat/group, send it a message
# 3. Get chat ID: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
